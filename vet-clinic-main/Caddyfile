:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # internal PHP files must never be requested directly
    @internal path /config.php /api/bootstrap.php /api/helpers.php
    respond @internal 404

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    php_server
}
